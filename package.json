{
  "name": "fibranexus-manager",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev:server": "corepack pnpm --filter fibranexus-server dev",
    "dev:client": "corepack pnpm --filter fibranexus-client dev",
    "build:client": "corepack pnpm --filter fibranexus-client build",
    "build:server": "corepack pnpm --filter fibranexus-server build",
    "build": "corepack pnpm run build:client && corepack pnpm run build:server",
    "start": "corepack pnpm --filter fibranexus-server start",
    "bootstrap:admin": "corepack pnpm --filter fibranexus-server exec node ../scripts/bootstrap-admin.mjs"
  }
}
