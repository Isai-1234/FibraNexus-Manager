{
  "name": "fibranexus-server",
  "version": "1.2.9",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "worker:bullmq": "node src/worker-bullmq.js",
    "build": "corepack pnpm --filter fibranexus-client build",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/seed.js",
    "lab:detected": "node ../scripts/lab-detected-check.mjs",
    "test": "node --test src/lib/__tests__/*.test.js",
    "migrate": "node ../scripts/run-migrations.mjs",
    "migrate:encrypt-secrets": "node ../scripts/migrate-encrypt-secrets.mjs",
    "repair:utf8": "node scripts/repair-utf8-mojibake.mjs",
    "repair:org-settings": "node scripts/repair-org-settings-json.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.1",
    "express": "^4.18.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "net-snmp": "^3.11.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.3",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.13.9",
    "drizzle-kit": "^0.20.6"
  }
}
