# ─── Base de datos (Supabase) ───────────────────────────────
# Direct: postgresql://postgres.[ref]:[pass]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Pooler (recomendado >20 conexiones): puerto 6543, mode=transaction
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DB_POOL_MAX=10

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Cifrado en reposo de secretos de equipos (32 bytes hex = 64 chars)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Bootstrap CLI únicamente (nunca HTTP). ALLOW_BOOTSTRAP=1 node scripts/bootstrap-admin.mjs ...
# ALLOW_BOOTSTRAP=0

# ─── URLs (Vercel + Render) ─────────────────────────────────
FRONTEND_URL=https://tu-app.vercel.app
PUBLIC_URL=https://tu-api.onrender.com
# Vercel (client): VITE_API_URL=https://tu-api.onrender.com/api

# ─── Plataforma ─────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@fibranexus.cl
PORT=10000

# ─── Escala (opcional, default = monolito local) ────────────
# all = API + scheduler (desarrollo)
# api = solo HTTP, sin scheduler
# worker = solo scheduler + cola (Render servicio 2)
PROCESS_ROLE=all

# NO activar hasta implementar bullmq real — el proceso aborta si USE_JOB_QUEUE=true
# REDIS_URL=rediss://default:token@host.upstash.io:6379
# USE_JOB_QUEUE=false

# Render inyecta esto en deploy
# RENDER_GIT_COMMIT=abc1234

# Migraciones versionadas (recomendado fuera del boot):
# node scripts/run-migrations.mjs
# node scripts/migrate-encrypt-secrets.mjs

# ─── Fase 3 pagos (stub hasta tener credenciales reales) ───
# PAYMENT_WEBHOOK_SECRET=cambia-este-secreto-hmac
# DEBT_NOTICE_PROVIDER=console
# ALLOW_STUB_PAYMENT=0
# FLOW_API_KEY=
# FLOW_SECRET_KEY=
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=

# ─── Egress FibraNexus (allowlist www-ssl en MikroTik Camino A) ──
# Lista corta compartida por todos los ISP. Separar por coma.
# FIBRANEXUS_EGRESS_CIDRS=134.209.43.175/32
FIBRANEXUS_EGRESS_CIDRS=134.209.43.175/32

# ─── Correo (recuperación de contraseña) ───────────────────
# Sin RESEND_API_KEY el enlace se imprime en los logs de Render.
# RESEND_API_KEY=re_xxx
# MAIL_FROM=FibraNexus <onboarding@resend.dev>
